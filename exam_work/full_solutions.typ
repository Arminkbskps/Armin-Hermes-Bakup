#qbox(46, "شمار مولکول‌های گلوکز در ۴۵۰ گرم", "صفحه ۶ • سوال ۱", "۲", [
  *صورت سوال:* در یک نمونهٔ ۴۵۰ گرمی از گلوکز، چند مولکول $"C"_6 "H"_(12) "O"_6$ وجود دارد؟ ($"C"=12, "O"=16, "H"=1$)
  
  *گام‌های حل تشریحی:*
  ۱) جرم مولی گلوکز: $M = 6(12) + 12(1) + 6(16) = 180 " g/mol"$.
  ۲) شمار مول‌های گلوکز:
  $ n = (450) / (180) = 2.5 " mol" $
  ۳) شمار مولکول‌ها:
  $ N = 2.5 times (6.02 times 10^(23)) = 15.05 times 10^(23) " مولکول" $
])

#qbox(47, "شمار اتم‌های هیدروژن در مخلوط اکتان و آب", "صفحه ۶ • سوال ۲", "۱", [
  *صورت سوال:* در ظرفی ۵/۷ گرم اکتان ($"C"_8 "H"_(18)$) و $18.06 times 10^(22)$ مولکول آب داریم. در مجموع چه تعداد اتم هیدروژن در این ظرف است؟
  
  *گام‌های حل تشریحی:*
  ۱) هیدروژن حاصل از اکتان ($M = 114 " g/mol"$):
  $ n("C"_8 "H"_(18)) = (5.7) / (114) = 0.05 " mol" ==> n_("H") = 0.05 times 18 = 0.90 " mol اتم H" $
  ۲) هیدروژن حاصل از آب:
  $ n("H"_2 "O") = (18.06 times 10^(22)) / (6.02 times 10^(23)) = 0.30 " mol" ==> n_("H") = 0.30 times 2 = 0.60 " mol اتم H" $
  ۳) مجموع مول اتم‌های هیدروژن:
  $ n_("کل H") = 0.90 + 0.60 = 1.50 " mol" $
  $ N_("کل H") = 1.50 times (6.02 times 10^(23)) = 9.03 times 10^(23) " اتم هیدروژن" $
])

#qbox(48, "بیشترین تعداد اتم‌ها در مواد داده‌شده", "صفحه ۶ • سوال ۳", "۲", [
  *صورت سوال:* در کدام گزینه تعداد اتم‌های بیشتری وجود دارد؟
  
  *گام‌های حل تشریحی:*
  - گزینه ۱ (۳۰ گرم اوره $"CO(NH"_2")"_2$ با $M = 60$ و ۸ اتم): $30 / 60 times 8 = 4.0 " mol اتم"$
  - گزینه ۲ (۴۰ گرم استیک اسید $"CH"_3"COOH"$ با $M = 60$ و ۸ اتم): $40 / 60 times 8 = 16 / 3 approx 5.33 " mol اتم"$
  - گزینه ۳ (۱/۵ مول $"SO"_2$ با ۳ اتم): $1.5 times 3 = 4.5 " mol اتم"$
  - گزینه ۴ (۱۶۰ گرم آهن(III) اکسید $"Fe"_2 "O"_3$ با $M = 160$ و ۵ اتم): $160 / 160 times 5 = 5.0 " mol اتم"$
  بیشترین شمار اتم‌ها متعلق به گزینه ۲ (استیک اسید با ۵/۳۳ مول اتم) است.
])

#qbox(49, "جرم الکترون‌ها در ۲۷۰ گرم نقره", "صفحه ۶ • سوال ۴", "۲", [
  *صورت سوال:* اگر جرم هر الکترون $9 times 10^(-28) " g"$ باشد، در ۲۷۰ گرم نقره ($""_(47)^(108)"Ag"$) چند گرم الکترون وجود دارد؟
  
  *گام‌های حل تشریحی:*
  ۱) مول اتم‌های نقره: $n = 270 / 108 = 2.5 " mol"$.
  ۲) هر اتم نقره ۴۷ الکترون دارد: $n_e = 2.5 times 47 = 117.5 " mol الکترون"$.
  ۳) شمار کل الکترون‌ها:
  $ N_e = 117.5 times (6.02 times 10^(23)) = 7.0735 times 10^(25) $
  ۴) جرم کل الکترون‌ها:
  $ m = (7.0735 times 10^(25)) times (9 times 10^(-28) " g") = 6.366 times 10^(-2) " g" approx 0.064 " g" $
])

#qbox(50, "برابری شمار اتم‌های شکر با سولفوریک اسید", "صفحه ۶ • سوال ۵", "۴", [
  *صورت سوال:* تعداد اتم‌های ۱۷/۱ گرم شکر ($"C"_(12) "H"_(22) "O"_(11)$) با تعداد اتم‌های چند گرم سولفوریک اسید ($"H"_2 "SO"_4$) برابر است؟
  
  *گام‌های حل تشریحی:*
  ۱) مول شکر ($M = 342 " g/mol"$): $n = (17.1) / (342) = 0.05 " mol"$.
  هر مولکول شکر ۴۵ اتم دارد: $n_("اتم") = 0.05 times 45 = 2.25 " mol اتم"$.
  ۲) هر مولکول سولفوریک اسید ($M = 98 " g/mol"$) دارای ۷ اتم است:
  $ n("H"_2 "SO"_4) times 7 = 2.25 ==> n("H"_2 "SO"_4) = 9 / 28 " mol" $
  ۳) جرم سولفوریک اسید:
  $ m = 9 / 28 times 98 = 9 times 3.5 = 31.5 " g" $
])

#qbox(51, "نسبت شمار اتم‌های CO2 به CH4 در جرم‌های برابر", "صفحه ۶ • سوال ۶", "۲", [
  *صورت سوال:* نسبت شمار اتم‌های $"CO"_2$ به $"CH"_4$ در جرم‌های برابر از این گازها کدام است؟
  
  *گام‌های حل تشریحی:*
  ۱) در جرم فرضی $m$ گرم:
  - برای $"CO"_2$ ($M = 44$، ۳ اتم): $N_1 = (m / 44) times 3$
  - برای $"CH"_4$ ($M = 16$، ۵ اتم): $N_2 = (m / 16) times 5$
  ۲) نسبت:
  $ (N_1) / (N_2) = (3m / 44) / (5m / 16) = 3 / 44 times 16 / 5 = 12 / 55 $
])

#qbox(52, "نسبت اتم‌ها در جرم برابر از A2 و عنصر B", "صفحه ۶ • سوال ۷", "۱", [
  *صورت سوال:* اگر جرم مولی A معادل ۲/۵ برابر B باشد، در جرم برابر از مولکول‌های $A_2$ و عنصر B، تعداد اتم‌های $A_2$ چند برابر B است؟
  
  *گام‌های حل تشریحی:*
  ۱) فرض می‌کنیم $M_B = M$، پس $M_A = 2.5 M$ و جرم مولی مولکول $A_2$ برابر $2(2.5 M) = 5 M$ است.
  ۲) در جرم برابر $m$:
  - مول اتم‌های A در مولکول $A_2$: $2 times (m / (5M)) = (0.4 m) / M$
  - مول اتم‌های B: $m / M$
  ۳) نسبت:
  $ "نسبت" = ((0.4 m) / M) / (m / M) = 0.4 $
])

#qbox(53, "تعیین فرمول مولکولی اکسید نیتروژن", "صفحه ۶ • سوال ۸", "۴", [
  *صورت سوال:* اگر $3.01 times 10^(21)$ مولکول از اکسید نیتروژن ۰/۲۲ گرم جرم داشته باشد، فرمول آن کدام است؟
  
  *گام‌های حل تشریحی:*
  ۱) شمار مول‌های این اکسید:
  $ n = (3.01 times 10^(21)) / (6.02 times 10^(23)) = 0.005 " mol" $
  ۲) جرم مولی اکسید:
  $ M = (0.22) / (0.005) = 44 " g/mol" $
  ۳) بررسی فرمول‌ها:
  جرم مولی $"N"_2"O" = 2(14) + 16 = 44 " g/mol"$ دقیقاً با نتیجه مطابقت دارد.
])

#qbox(54, "تعداد اتم‌ها در 0.01 مول SF6", "صفحه ۶ • سوال ۹", "۳", [
  *صورت سوال:* $3.01 times 10^(22)$ مولکول $"SF"_n$ جرمی برابر ۷/۳ گرم دارد. در ۰/۰۱ مول از این ترکیب چند اتم وجود دارد؟
  
  *گام‌های حل تشریحی:*
  ۱) مول مولکول‌ها: $n = (3.01 times 10^(22)) / (6.02 times 10^(23)) = 0.05 " mol"$.
  ۲) جرم مولی $"SF"_n$:
  $ M = (7.3) / (0.05) = 146 " g/mol" ==> 32 + 19n = 146 ==> 19n = 114 ==> n = 6 $
  ترکیب گوگرد هگزافلوئورید ($"SF"_6$) است که هر مولکول آن ۷ اتم دارد.
  ۳) در ۰/۰۱ مول از $"SF"_6$:
  $ N_("اتم‌ها") = 0.01 times 7 times (6.02 times 10^(23)) = 4.214 times 10^(22) = 42.14 times 10^(21) " اتم" $
])

