#qbox(7, "ایزوتوپ‌های گلوکز و استوکیومتری هیدروژن", "صفحه ۲ • سوال ۷", "۲", [
  *صورت سوال:* ایزوتوپ‌های طبیعی هیدروژن ($""^1"H", ""^2"H", ""^3"H"$)، کربن ($""^(12)"C", ""^(13)"C", ""^(14)"C"$) و اکسیژن ($""^(16)"O", ""^(17)"O", ""^(18)"O"$) در یکی از مولکول‌های گلوکز به تعداد برابر قرار گرفته‌اند. $36.12 times 10^(22)$ اتم هیدروژن در چند گرم از این نمونه گلوکز وجود دارد؟
  
  *گام‌های حل تشریحی:*
  ۱) فرمول مولکولی گلوکز $"C"_6 "H"_(12) "O"_6$ است. با توجه به برابری تعداد هر سه ایزوتوپ در این مولکول خاص:
  - ۶ اتم کربن: از هر ایزوتوپ ۲ اتم ($2 times 12 + 2 times 13 + 2 times 14 = 78 " g"$)
  - ۱۲ اتم هیدروژن: از هر ایزوتوپ ۴ اتم ($4 times 1 + 4 times 2 + 4 times 3 = 24 " g"$)
  - ۶ اتم اکسیژن: از هر ایزوتوپ ۲ اتم ($2 times 16 + 2 times 17 + 2 times 18 = 102 " g"$)
  جرم این مولکول گلوکز برابر است با:
  $ M = 78 + 24 + 102 = 204 " g/mol" $
  ۲) مول اتم‌های هیدروژن داده شده:
  $ n_("H") = (36.12 times 10^(22)) / (6.02 times 10^(23)) = 0.6 " mol اتم H" $
  ۳) چون در هر مولکول گلوکز ۱۲ اتم هیدروژن وجود دارد:
  $ n_("گلوکز") = (0.6) / (12) = 0.05 " mol" $
  ۴) جرم نمونه گلوکز:
  $ m = 0.05 times 204 = 10.2 " g" $
])

#qbox(8, "شمار نوترون‌ها در ۳۱/۲ گرم یون 78_X^2-", "صفحه ۲ • سوال ۸", "۱", [
  *صورت سوال:* در یون $""^(78)X^(2-)$ تفاوت شمار نوترون‌ها و الکترون‌ها برابر ۸ است. در ۳۱/۲ گرم از این یون به تقریب چند نوترون وجود دارد؟
  
  *گام‌های حل تشریحی:*
  ۱) در یون $""^(78)X^(2-)$ داریم: $A = 78 ==> p + N = 78 ==> N = 78 - p$
  و تعداد الکترون‌ها: $e = p + 2$
  ۲) تفاوت نوترون‌ها و الکترون‌ها برابر ۸ است:
  $ N - e = 8 ==> (78 - p) - (p + 2) = 8 ==> 76 - 2p = 8 ==> 2p = 68 ==> p = 34 $
  پس تعداد نوترون‌های هر یون برابر است با:
  $ N = 78 - 34 = 44 " نوترون" $
  ۳) جرم مولی یون برابر عدد جرمی یعنی $78 " g/mol"$ است:
  $ n = (31.2) / (78) = 0.4 " mol یون" $
  ۴) شمار کل نوترون‌ها:
  $ N_("کل نوترون‌ها") = 0.4 " mol" times 44 times (6.02 times 10^(23)) = 1.0595 times 10^(25) approx 1.06 times 10^(25) $
])

#qbox(9, "جرم اتمی میانگین و جرم ایزوتوپ سبک‌تر در منیزیم", "صفحه ۲ • سوال ۹", "۱", [
  *صورت سوال:* در نمونه طبیعی منیزیم به جرم ۸۱ گرم، سه ایزوتوپ $""^(24)"Mg", ""^(25)"Mg", ""^(26)"Mg"$ وجود دارد. اگر درصد فراوانی سبک‌تر ۴ برابر مجموع دو ایزوتوپ دیگر و فراوانی دو ایزوتوپ دیگر برابر باشد، جرم اتمی میانگین و جرم ایزوتوپ سبک‌تر چند است؟
  
  *گام‌های حل تشریحی:*
  ۱) روابط فراوانی‌ها:
  $ cases(F_2 = F_3, F_1 = 4(F_2 + F_3) = 8 F_2, F_1 + F_2 + F_3 = 100) ==> 8 F_2 + F_2 + F_2 = 100 ==> 10 F_2 = 100 ==> F_2 = 10% $
  پس: $F_1 = 80%, F_2 = 10%, F_3 = 10%$
  ۲) جرم اتمی میانگین منیزیم:
  $ bar(M) = (24 times 80 + 25 times 10 + 26 times 10) / 100 = (1920 + 250 + 260) / 100 = 24.3 " amu" $
  ۳) کل مول‌های منیزیم در ۸۱ گرم:
  $ n_("کل") = (81) / (24.3) = 10 / 3 " mol" $
  ۴) جرم ایزوتوپ سبک‌تر ($""^(24)"Mg"$ با فراوانی ۸۰٪):
  $ n_1 = 0.80 times 10 / 3 = 8 / 3 " mol" ==> m_1 = 8 / 3 times 24 = 64 " g" $
  بنابراین از راست به چپ: ۲۴/۳ و ۶۴.
])

#qbox(10, "منیزیم نیترید Mg3N2، فراوانی ایزوتوپ و مقایسه با SO2", "صفحه ۲ • سوال ۱۰", "۳", [
  *صورت سوال:* در $30.45 " g"$ منیزیم نیترید ($"Mg"_3 "N"_2$) شمار کل یون‌ها $9.03 times 10^(23)$ است. با داشتن $F(24)=70%$، فراوانی ایزوتوپ سنگین‌تر و نسبت کاتیون‌ها به اتم‌های اکسیژن در ۹/۶ گرم $"SO"_2$ کدام است؟
  
  *گام‌های حل تشریحی:*
  ۱) مول یون‌ها: $n_("یون‌ها") = (9.03 times 10^(23)) / (6.02 times 10^(23)) = 1.5 " mol"$.
  هر واحد فرمولی $"Mg"_3 "N"_2$ شامل ۵ یون ($3 "Mg"^(2+) + 2 "N"^(3-)$) است:
  $ n("Mg"_3 "N"_2) = (1.5) / 5 = 0.3 " mol" $
  ۲) جرم مولی این نمونه $"Mg"_3 "N"_2$:
  $ M = (30.45) / (0.3) = 101.5 " g/mol" ==> 3 bar(M)_("Mg") + 2(14) = 101.5 ==> 3 bar(M)_("Mg") = 73.5 ==> bar(M)_("Mg") = 24.5 $
  ۳) محاسبه فراوانی ایزوتوپ سنگین‌تر ($""^(26)"Mg"$):
  $ F_1 = 70%, F_2 + F_3 = 30% ==> F_2 = 30 - F_3 $
  $ bar(M) = (24 times 70 + 25(30 - F_3) + 26 F_3) / 100 = 24.5 ==> 1680 + 750 + F_3 = 2450 ==> F_3 = 20% $
  ۴) شمار کاتیون‌های منیزیم در ۰/۳ مول منیزیم نیترید:
  $ n("Mg"^(2+)) = 0.3 times 3 = 0.9 " mol" $
  ۵) شمار اتم‌های اکسیژن در ۹/۶ گرم $"SO"_2$ ($M = 64 " g/mol"$):
  $ n("SO"_2) = (9.6) / 64 = 0.15 " mol" ==> n_("O") = 0.15 times 2 = 0.30 " mol اتم اکسیژن" $
  ۶) نسبت:
  $ "نسبت" = (0.90) / (0.30) = 3 $
  بنابراین مقادیر به ترتیب: ۲۰ و ۳.
])

#qbox(11, "شناسایی ایزوتوپ‌های سلنیم 78_34 Se", "صفحه ۲ • جامع ۳ - ۱", "۳", [
  *صورت سوال:* کدام یک از گونه‌های داده‌شده با اتم $""_(34)^(78)"Se"$ ایزوتوپ نیست؟
  
  *گام‌های حل تشریحی:*
  - اتم سلنیم $""_(34)^(78)"Se"$ دارای عدد اتمی $Z = 34$ و عدد جرمی $A = 78$ است. ایزوتوپ‌های آن باید الزاماً $Z = 34$ داشته باشند.
  - بررسی گزینه ۱: گونه $A^(2-)$ با ۸ زیرلایه پر ($1s, 2s, 2p, 3s, 3p, 4s, 3d, 4p$) دارای ۳۶ الکترون است. پس $Z_A = 36 - 2 = 34$ (سلنیم است).
  - بررسی گزینه ۲: اتم $G$ با $A = 79$ و اختلاف ذرات داخل و خارج هسته برابر ۴۵:
  $ (p + N) - e = A - p = N = 45 ==> p = 79 - 45 = 34 $ (سلنیم است).
  - بررسی گزینه ۳: گونه $B^(2+)$ دارای ۳۶ الکترون است. پس $Z_B = 36 + 2 = 38$ (استرانسیم است و عدد اتمی آن ۳۸ است، نه ۳۴). بنابراین با سلنیم ایزوتوپ نیست.
  - بررسی گزینه ۴: هم‌گروه با اکسیژن (گروه ۱۶) و هم‌دوره با آهن (دوره ۴)، دقیقاً سلنیم با $Z = 34$ است.
])

#qbox(12, "سینتیک واپاشی و جرم اولیه دو ایزوتوپ A و B", "صفحه ۲ • جامع ۳ - ۲", "۴", [
  *صورت سوال:* نیم‌عمر ایزوتوپ A برابر ۴۰ دقیقه و B برابر ۵۰ دقیقه است. با توجه به شرایط داده شده، جرم اولیه A چند گرم است؟
  
  *گام‌های حل تشریحی:*
  ۱) پس از ۱۲۰ دقیقه برای A ($120/40 = 3$ نیم‌عمر):
  $ m_("متلاشی A") = m_(A 0)(1 - (1/2)^3) = 7 / 8 m_(A 0) $
  ۲) پس از ۲۰۰ دقیقه برای B ($200/50 = 4$ نیم‌عمر):
  $ m_("متلاشی B") = m_(B 0)(1 - (1/2)^4) = 15 / 16 m_(B 0) $
  طبق شرط اول:
  $ 7 / 8 m_(A 0) = 0.70 times 15 / 16 m_(B 0) ==> 7 / 8 m_(A 0) = 7 / 10 times 15 / 16 m_(B 0) ==> m_(A 0) = 3 / 4 m_(B 0) ==> m_(B 0) = 4 / 3 m_(A 0) $
  ۳) طبق شرط دوم (تفاضل باقی‌مانده‌ها پس از ۲۰۰ دقیقه برای A و ۳۰۰ دقیقه برای B):
  - باقی‌مانده A پس از ۵ نیم‌عمر: $m_(A 0) / 32$
  - باقی‌مانده B پس از ۶ نیم‌عمر: $m_(B 0) / 64$
  $ m_(A 0) / 32 - m_(B 0) / 64 = 0.75 ==> m_(A 0) / 32 - (4/3 m_(A 0)) / 64 = 0.75 ==> m_(A 0) / 32 - m_(A 0) / 48 = 0.75 $
  $ (3 m_(A 0) - 2 m_(A 0)) / 96 = 0.75 ==> m_(A 0) / 96 = 3 / 4 ==> m_(A 0) = 72 " g" $
])

#qbox(13, "تعیین فرمول زنون فلوئورید XeFn و جرم فلوئور", "صفحه ۲ • جامع ۳ - ۳", "۲", [
  *صورت سوال:* ۱۰/۳۵ گرم از $"XeF"_n$ دارای $15.05 times 10^(22)$ اتم است. $n$ کدام است و در چند گرم از این ترکیب، ۲۶/۶ گرم فلوئور وجود دارد؟ ($"Xe"=131, "F"=19$)
  
  *گام‌های حل تشریحی:*
  ۱) مول کل اتم‌ها: $n_("اتم") = (15.05 times 10^(22)) / (6.02 times 10^(23)) = 0.25 " mol"$.
  ۲) در هر مولکول $"XeF"_n$ تعداد $1 + n$ اتم وجود دارد. پس مول مولکول‌ها برابر $(0.25) / (1 + n)$ است:
  $ M = m / n = (10.35) / (0.25 / (1 + n)) = 41.4(1 + n) $
  از طرفی: $M = 131 + 19n$.
  $ 131 + 19n = 41.4 + 41.4n ==> 89.6 = 22.4n ==> n = 4 $
  فرمول مولکولی ترکیب $"XeF"_4$ و جرم مولی آن $131 + 4(19) = 207 " g/mol"$ است.
  ۳) در ۱ مول $"XeF"_4$ مقدار $4 times 19 = 76 " g"$ فلوئور وجود دارد.
  $ m("ترکیب") = 26.6 " g F" times (207 " g XeF"_4) / (76 " g F") = 72.45 " g" $
  بنابراین از راست به چپ: ۴ و ۷۲/۴۵.
])

#qbox(14, "اختلاف جرم سبک‌ترین و سنگین‌ترین مولکول AB2", "صفحه ۲ • جامع ۳ - ۴", "۲", [
  *صورت سوال:* عنصرهای A و B هر کدام دارای سه ایزوتوپ با جرم میانگین ۱۲/۲۵ و ۷۹/۵ هستند. اختلاف جرم سبک‌ترین و سنگین‌ترین مولکول $"AB"_2$ چند amu است؟
  
  *گام‌های حل تشریحی:*
  ۱) برای عنصر A: ایزوتوپ‌های طبیعی کربن‌مانند با میانگین ۱۲/۲۵ شامل $""^(12)A (80%), ""^(13)A (15%), ""^(14)A (5%)$ است که در آن سبک‌ترین ۱۲ و سنگین‌ترین ۱۴ بوده و $Delta M_A = 14 - 12 = 2 " amu"$ است.
  ۲) برای عنصر B: از اطلاعات بند II (مجموع ۸۵ و تفاضل ۷۵):
  $ F(79) + F(81) = 85%, F(79) - F(81) = 75% ==> F(79) = 80%, F(81) = 5% $
  ایزوتوپ سوم دارای فراوانی ۱۵٪ و جرم ۸۲ است (میانگین وزنی: $0.80(79) + 0.05(81) + 0.15(82) = 79.55 approx 79.5$).
  سبک‌ترین ایزوتوپ ۷۹ و سنگین‌ترین ۸۲ بوده و $Delta M_B = 82 - 79 = 3 " amu"$ است.
  ۳) اختلاف جرم سبک‌ترین و سنگین‌ترین مولکول $"AB"_2$:
  $ Delta M("AB"_2) = Delta M_A + 2 times Delta M_B = 2 + 2(3) = 8 " amu" $
])

