#qbox(37, "استیک اسید، ترفتالیک اسید و اختلاف جرم کربن", "صفحه ۵ • سوال ۱۲", "۲", [
  *صورت سوال:* هیدروژن چند گرم استیک اسید ($"CH"_3"COOH"$) ۲ برابر اکسیژن ۴۹/۸ گرم ترفتالیک اسید ($"C"_8"H"_6"O"_4$) است و اختلاف جرم کربن آن‌ها چند گرم است؟
  
  *گام‌های حل تشریحی:*
  ۱) مول ترفتالیک اسید ($M = 8(12) + 6(1) + 4(16) = 166 " g/mol"$):
  $ n = (49.8) / (166) = 0.3 " mol" $
  هر مول آن ۴ مول اکسیژن دارد، پس: $n_("O") = 0.3 times 4 = 1.2 " mol اتم O"$.
  ۲) هیدروژن استیک اسید ۲ برابر اکسیژن ترفتالیک اسید است:
  $ n_("H") = 2 times 1.2 = 2.4 " mol اتم H" $
  چون هر استیک اسید ۴ هیدروژن دارد: $n_("استیک") = (2.4) / 4 = 0.6 " mol"$.
  جرم استیک اسید ($M = 60 " g/mol"$):
  $ m = 0.6 times 60 = 36 " g" $
  ۳) محاسبه اختلاف جرم کربن در دو نمونه:
  - کربن در ترفتالیک اسید: $0.3 times 8 = 2.4 " mol C" ==> 2.4 times 12 = 28.8 " g C"$
  - کربن در استیک اسید: $0.6 times 2 = 1.2 " mol C" ==> 1.2 times 12 = 14.4 " g C"$
  - اختلاف: $28.8 - 14.4 = 14.4 " g"$
  بنابراین مقادیر: ۳۶ و ۱۴/۴.
])

#qbox(38, "نوترون‌های اکسید سومین فلز قلیایی X2O", "صفحه ۵ • سوال ۱۳", "۳", [
  *صورت سوال:* سومین فلز قلیایی شامل سه ایزوتوپ با ۲۰، ۲۱ و ۲۲ نوترون است. مجموع فراوانی دو سنگین‌تر ۱۵٪ و نسبت سبک‌ترین به سنگین‌ترین ۸/۵ است. در ۱۸۹ گرم $"X"_2"O"$ چند مول نوترون وجود دارد؟
  
  *گام‌های حل تشریحی:*
  ۱) سومین فلز قلیایی پتاسیم ($"K"$) با $Z = 19$ است.
  ۲) درصد فراوانی‌ها:
  $ F_2 + F_3 = 15% ==> F_1 = 85% $
  $ (F_1) / (F_3) = 8.5 ==> (85) / (F_3) = 8.5 ==> F_3 = 10% ==> F_2 = 5% $
  ۳) میانگین نوترون‌های پتاسیم:
  $ bar(N) = (20 times 85 + 21 times 5 + 22 times 10) / 100 = 20.25 " نوترون" $
  جرم اتمی میانگین: $bar(M)_X = 19 + 20.25 = 39.25 " amu"$.
  ۴) جرم مولی اکسید $"X"_2"O"$:
  $ M("X"_2"O") = 2(39.25) + 16 = 78.5 + 16 = 94.5 " g/mol" $
  مول $"X"_2"O"$ در ۱۸۹ گرم:
  $ n = (189) / (94.5) = 2.0 " mol" $
  ۵) شمار کل نوترون‌ها در ۲ مول $"X"_2"O"$:
  - در هر فرمول $"X"_2"O"$، ۲ اتم پتاسیم و ۱ اتم اکسیژن ($16 - 8 = 8$ نوترون) وجود دارد:
  $ "نوترون در هر مول" = 2(20.25) + 8 = 40.5 + 8 = 48.5 " mol" $
  $ "کل نوترون‌ها" = 2.0 times 48.5 = 97 " mol نوترون" $
])

#qbox(39, "درصد جرمی آهن و درصد مولی مس", "صفحه ۵ • سوال ۱۴", "۳", [
  *صورت سوال:* در ۴۴ گرم مخلوط آهن و مس، $4.515 times 10^(23)$ اتم وجود دارد. درصد جرمی آهن و درصد مولی مس کدام است؟ ($"Fe"=56, "Cu"=64$)
  
  *گام‌های حل تشریحی:*
  ۱) مول کل اتم‌ها:
  $ n_("کل") = (4.515 times 10^(23)) / (6.02 times 10^(23)) = 0.75 " mol" $
  ۲) دستگاه دو مجهولی ($x$ مول آهن و $y$ مول مس):
  $ cases(x + y = 0.75, 56x + 64y = 44) ==> 56x + 64(0.75 - x) = 44 ==> -8x = -4 ==> x = 0.50 " mol Fe" $
  $ y = 0.75 - 0.50 = 0.25 " mol Cu" $
  ۳) درصد جرمی آهن:
  $ m_("Fe") = 0.50 times 56 = 28 " g" ==> %"جرمی Fe" = (28) / (44) times 100 = 63.63% approx 63.6% $
  ۴) درصد مولی مس:
  $ %"مولی Cu" = (0.25) / (0.75) times 100 = 33.33% approx 33.3% $
  بنابراین مقادیر: ۶۳/۶ و ۳۳/۳.
])

#qbox(40, "درصد مولی یون نیترات در مخلوط با سولفات", "صفحه ۵ • سوال ۱۵", "۴", [
  *صورت سوال:* در مخلوطی از یون‌های سولفات و نیترات، ۲۷۲ گرم اکسیژن است. اگر الکترون‌های سولفات به اندازه $2.408 times 10^(24)$ بیشتر از نیترات باشد، چند درصد مولی مخلوط نیترات است؟
  
  *گام‌های حل تشریحی:*
  ۱) جرم اکسیژن ۲۷۲ گرم است ($272 / 16 = 17 " mol O"$):
  $ 4x + 3y = 17 $
  ۲) الکترون‌ها:
  - هر سولفات ($"SO"_4^(2-)$) دارای ۵۰ الکترون و هر نیترات ($"NO"_3^-$) دارای ۳۲ الکترون است.
  - اختلاف الکترون‌ها ۴ مول است ($2.408 times 10^(24) / 6.02 times 10^(23) = 4 " mol"$):
  $ 50x - 32y = 4 $
  ۳) حل دستگاه:
  $ cases(4x + 3y = 17, 50x - 32y = 4) ==> x = 2 " mol " "SO"_4^(2-) , y = 3 " mol " "NO"_3^- $
  ۴) درصد مولی یون نیترات:
  $ %"مولی نیترات" = (3) / (2 + 3) times 100 = 60% $
])

#qbox(41, "واپاشی ایزوتوپ‌های هیدروژن", "صفحه ۵ • سوال ۱۶", "۱", [
  *صورت سوال:* پس از $9 times 10^(-22) " s"$، درصد فراوانی B چند درصد کاهش و درصد جرمی A چند درصد افزایش می‌یابد؟
  
  *گام‌های حل تشریحی:*
  ۱) شناسایی ایزوتوپ‌ها:
  - ایزوتوپ A: ذرات برابر ($p=e=n=1$) یعنی دوتریوم $""^2"H"$ ($4 " g" = 2 " mol"$).
  - ایزوتوپ B: پایدارترین ساختگی یعنی $""^4"H"$ با نیم‌عمر $9 times 10^(-22) " s"$ ($10 " g" = 2.5 " mol"$).
  - ایزوتوپ C: دارای ۵ نوترون یعنی $""^6"H"$ با نیم‌عمر $3 times 10^(-22) " s"$ ($6 " g" = 1 " mol"$).
  ۲) وضعیت پس از $9 times 10^(-22) " s"$:
  - برای B: ۱ نیم‌عمر گذشته $==>$ جرم ۵ گرم، مول ۱/۲۵.
  - برای C: ۳ نیم‌عمر گذشته $==>$ جرم ۰/۷۵ گرم، مول ۰/۱۲۵.
  - برای A: پایدار است $==>$ جرم ۴ گرم، مول ۲.
  ۳) کاهش درصد فراوانی (مولی) B:
  $ %B_("ابتدایی") = (2.5) / (5.5) times 100 = 45.45% $
  $ %B_("نهایی") = (1.25) / (2 + 1.25 + 0.125) times 100 = (1.25) / (3.375) times 100 = 37.04% $
  $ Delta %B = 45.45% - 37.04% approx 8% " کاهش" $
  ۴) افزایش درصد جرمی A:
  $ %A_("جرمی ابتدایی") = (4) / (20) times 100 = 20% $
  $ %A_("جرمی نهایی") = (4) / (4 + 5 + 0.75) times 100 = (4) / (9.75) times 100 = 41.02% $
  $ Delta %A = 41.02% - 20% approx 21% " افزایش" $
  بنابراین مقادیر: ۲۱ و ۸.
])

#qbox(42, "عدد اتمی X و مجموع گروه و دوره در یون X2-", "صفحه ۵ • جامع ۱ - ۱", "۲", [
  *صورت سوال:* در یون $X^(2-)$ اختلاف نوترون و پروتون ۲۰٪ بیشتر از اختلاف نوترون و الکترون است. با داشتن ۱۱۶ ذره زیراتمی، عدد اتمی و مجموع شماره گروه و دوره کدام است؟
  
  *گام‌های حل تشریحی:*
  ۱) در یون $X^(2-)$ داریم: $p = Z, e = Z + 2, N = A - Z$.
  $ N - Z = 1.20(N - (Z + 2)) = 1.20(N - Z - 2) ==> 0.20(N - Z) = 2.4 ==> N - Z = 12 $
  ۲) مجموع ذرات زیراتمی ۱۱۶ است:
  $ Z + (Z + 2) + (Z + 12) = 116 ==> 3Z + 14 = 116 ==> 3Z = 102 ==> Z = 34 $
  ۳) عنصر با $Z = 34$ سلنیم ($"Se"$) است:
  - آرایش الکترونی: $["Ar"] 3d^(10) 4s^2 4p^4$
  - دوره: ۴ ، گروه: ۱۶
  - مجموع شماره گروه و دوره: $16 + 4 = 20$
  بنابراین مقادیر: ۲۰ و ۳۴.
])

#qbox(43, "نسبت درصد فراوانی ایزوتوپ‌های استرانسیم", "صفحه ۵ • جامع ۱ - ۲", "۴", [
  *صورت سوال:* استرانسیم ۴ ایزوتوپ ۸۴، ۸۶، ۸۷ و ۸۸ دارد. اگر فراوانی چهارم ۴ برابر مجموع بقیه و فراوانی سوم برابر مجموع دو سبک‌تر باشد و میانگین ۸۷/۶۶ شود، نسبت فراوانی دوم به اول کدام است؟
  
  *گام‌های حل تشریحی:*
  ۱) $F_4 = 4(F_1 + F_2 + F_3) ==> 5(F_1 + F_2 + F_3) = 100 ==> F_4 = 80%, F_1 + F_2 + F_3 = 20%$.
  ۲) $F_3 = F_1 + F_2 ==> 2 F_3 = 20% ==> F_3 = 10% ==> F_1 + F_2 = 10% ==> F_2 = 10 - F_1$.
  ۳) رابطه جرم اتمی میانگین:
  $ 84 F_1 + 86(10 - F_1) + 87(10) + 88(80) = 8766 $
  $ 84 F_1 + 860 - 86 F_1 + 870 + 7040 = 8766 ==> -2 F_1 + 8770 = 8766 ==> 2 F_1 = 4 ==> F_1 = 2% $
  $ F_2 = 10 - 2 = 8% $
  ۴) نسبت فراوانی ایزوتوپ دوم به اول:
  $ (F_2) / (F_1) = (8%) / (2%) = 4 $
])

#qbox(44, "مخلوط SO2 و اتانول، درصد مولی و مول اکسیژن", "صفحه ۵ • جامع ۱ - ۳", "۱", [
  *صورت سوال:* در ۱۰۱ گرم مخلوط $"SO"_2$ و $"C"_2 "H"_5 "OH"$ تعداد $1.806 times 10^(24)$ اتم کربن وجود دارد. درصد مولی ترکیب سنگین‌تر و مول اتم اکسیژن کدام است؟
  
  *گام‌های حل تشریحی:*
  ۱) مول اتم‌های کربن: $n_("C") = (1.806 times 10^(24)) / (6.02 times 10^(23)) = 3 " mol"$.
  چون هر مول اتانول دارای ۲ مول کربن است:
  $ n_("اتانول") = 3 / 2 = 1.5 " mol" $
  ۲) جرم اتانول ($M = 46 " g/mol"$): $1.5 times 46 = 69 " g"$.
  جرم $"SO"_2$: $101 - 69 = 32 " g"$.
  مول $"SO"_2$ ($M = 64 " g/mol"$): $n("SO"_2) = 32 / 64 = 0.5 " mol"$.
  ۳) ترکیب با جرم مولی بیشتر، $"SO"_2$ ($64 > 46$) است:
  $ %"مولی " "SO"_2 = (0.5) / (0.5 + 1.5) times 100 = 25% $
  ۴) کل مول‌های اتم اکسیژن:
  $ n_("O") = 0.5 times 2 ("از SO"_2) + 1.5 times 1 ("از اتانول") = 1.0 + 1.5 = 2.5 " mol" $
  بنابراین مقادیر: ۲۵ و ۲/۵.
])

#qbox(45, "شمار نوترون‌های آنیون A- با ۵۵ ذره زیراتمی", "صفحه ۵ • جامع ۱ - ۴", "۴", [
  *صورت سوال:* در یون $A^-$ تفاوت نوترون‌ها و الکترون‌ها ۲ و مجموع ذرات ۵۵ است. تعداد نوترون‌های $A$ کدام است؟
  
  *گام‌های حل تشریحی:*
  ۱) روابط: $e = Z + 1$ و $N - e = 2 ==> N - (Z + 1) = 2 ==> N = Z + 3$.
  ۲) مجموع ذرات زیراتمی:
  $ p + e + N = 55 ==> Z + (Z + 1) + (Z + 3) = 55 ==> 3Z + 4 = 55 ==> 3Z = 51 ==> Z = 17 $
  ۳) شمار نوترون‌ها:
  $ N = Z + 3 = 17 + 3 = 20 " نوترون" $
])

