#qbox(16, "نوترون‌های آمونیاک و مول کروم", "صفحه ۳ • سوال ۱۸", "۳", [
  *صورت سوال:* در ۰/۱۷ گرم آمونیاک ($"NH"_3$) به تقریب چند نوترون وجود دارد و این تعداد نوترون تقریباً در چند مول کروم ($""_(24)^(52)"Cr"$) یافت می‌شود؟
  
  *گام‌های حل تشریحی:*
  ۱) در هر مولکول آمونیاک ($"NH"_3$):
  - اتم نیتروژن ($""_7^(14)"N"$) دارای $14 - 7 = 7$ نوترون است.
  - اتم‌های هیدروژن ($""_1^1"H"$) فاقد نوترون هستند ($N = 0$).
  بنابراین هر مولکول $"NH"_3$ دقیقاً ۷ نوترون دارد.
  ۲) مول آمونیاک در ۰/۱۷ گرم ($M = 17 " g/mol"$):
  $ n = (0.17) / (17) = 0.01 " mol" $
  $ N_("نوترون‌ها") = 0.01 " mol" times 7 times (6.02 times 10^(23)) = 4.214 times 10^(22) = 42 times 10^(21) " نوترون" $
  ۳) در هر اتم کروم ($""_(24)^(52)"Cr"$) تعداد $52 - 24 = 28$ نوترون وجود دارد.
  $ n_("Cr") = (0.01 times 7) / (28) = (0.07) / (28) = 0.0025 = 2.5 times 10^(-3) " mol Cr" $
  بنابراین از راست به چپ: $42 times 10^(21)$ و $2.5 times 10^(-3)$.
])

#qbox(17, "اختلاف تعداد اتم‌های 24Mg و 26Mg", "صفحه ۳ • سوال ۱۹", "۱", [
  *صورت سوال:* منیزیم دارای ایزوتوپ‌های ۲۴، ۲۵ (۱۰٪) و ۲۶ (۱۱٪) است. در ۱/۲۱۶ گرم منیزیم، اختلاف تعداد اتم‌های $""^(24)"Mg"$ و $""^(26)"Mg"$ کدام است؟
  
  *گام‌های حل تشریحی:*
  ۱) فراوانی ایزوتوپ سبک‌تر:
  $ F_1 = 100 - (10 + 11) = 79% $
  اختلاف درصد فراوانی دو ایزوتوپ ۲۴ و ۲۶:
  $ Delta F = 79% - 11% = 68% = 0.68 $
  ۲) جرم اتمی میانگین منیزیم:
  $ bar(M) = (24 times 79 + 25 times 10 + 26 times 11) / 100 = (1896 + 250 + 286) / 100 = 24.32 " g/mol" $
  ۳) کل مول اتم‌های منیزیم در ۱/۲۱۶ گرم:
  $ n = (1.216) / (24.32) = 0.05 " mol" $
  ۴) اختلاف تعداد اتم‌ها:
  $ Delta N = 0.68 times (0.05 times 6.02 times 10^(23)) = 0.68 times 3.01 times 10^(22) approx 2.05 times 10^(22) $
])

#qbox(18, "درصد جرمی متان در مخلوط با پروپان", "صفحه ۳ • سوال ۲۰", "۱", [
  *صورت سوال:* در مخلوطی از متان ($"CH"_4$) و پروپان ($"C"_3 "H"_8$) به جرم ۱۴۰ گرم، $156.52 times 10^(23)$ اتم هیدروژن موجود است. چند درصد جرم مخلوط را متان تشکیل داده است؟
  
  *گام‌های حل تشریحی:*
  ۱) مول اتم‌های هیدروژن:
  $ n_("H") = (156.52 times 10^(23)) / (6.02 times 10^(23)) = 26 " mol اتم H" $
  ۲) دستگاه معادلات ($x$ مول $"CH"_4$ و $y$ مول $"C"_3 "H"_8$):
  $ cases(4x + 8y = 26 ==> 2x + 4y = 13, 16x + 44y = 140) $
  ۳) با ضرب معادله اول در $-8$ و جمع با معادله جرم:
  $ -16x - 32y = -104 $
  $ (16x + 44y) - (16x + 32y) = 140 - 104 ==> 12y = 36 ==> y = 3 " mol " "C"_3 "H"_8 $
  $ 2x = 13 - 4(3) = 1 ==> x = 0.5 " mol " "CH"_4 $
  ۴) جرم متان و درصد جرمی آن:
  $ m_("متان") = 0.5 times 16 = 8 " g" $
  $ %"جرمی متان" = (8) / (140) times 100 = 5.71% approx 5.7% $
])

#qbox(19, "شناسایی ایزوتوپ‌های یون X2+", "صفحه ۳ • جامع ۲ - ۱", "۳", [
  *صورت سوال:* در یون $X^(2+)$ تفاوت نوترون‌ها و الکترون‌ها ۲۷ و مجموع ذرات ۱۹۱ است. چه تعداد از گونه‌های داده‌شده ایزوتوپ $X$ هستند؟
  
  *گام‌های حل تشریحی:*
  ۱) در یون $X^(2+)$: تعداد پروتون $Z$، الکترون $Z - 2$ و نوترون $N$ است:
  $ N - (Z - 2) = 27 ==> N - Z = 25 $
  $ p + e + N = 191 ==> Z + (Z - 2) + N = 191 ==> 2Z + N = 193 $
  ۲) جایگذاری $N = Z + 25$:
  $ 2Z + (Z + 25) = 193 ==> 3Z = 168 ==> Z = 56 $
  عنصر $X$ باریم ($"Ba"$) با عدد اتمی ۵۶ است.
  ۳) بررسی گونه‌ها:
  گونه‌هایی ایزوتوپ $X$ هستند که عدد اتمی آن‌ها ۵۶ باشد:
  $ ""_(56)^(137)"B" , ""_(56)^(139)"E" , ""_(56)^(140)"F" $
  دقیقاً ۳ گونه دارای $Z = 56$ بوده و ایزوتوپ $X$ هستند.
])

#qbox(20, "اختلاف درصد فراوانی ایزوتوپ‌های کلر در CH2Cl2", "صفحه ۳ • جامع ۲ - ۲", "۳", [
  *صورت سوال:* ۲/۱۴ گرم دی‌کلرومتان ($"CH"_2 "Cl"_2$) دارای $1.505 times 10^(22)$ مولکول است. اختلاف درصد فراوانی دو ایزوتوپ $""^(35)"Cl"$ و $""^(37)"Cl"$ کدام است؟
  
  *گام‌های حل تشریحی:*
  ۱) مول مولکول‌های دی‌کلرومتان:
  $ n = (1.505 times 10^(22)) / (6.02 times 10^(23)) = 0.025 " mol" $
  ۲) جرم مولی دی‌کلرومتان:
  $ M = (2.14) / (0.025) = 85.6 " g/mol" $
  $ M("CH"_2 "Cl"_2) = 12 + 2(1) + 2 bar(M)_("Cl") = 85.6 ==> 2 bar(M)_("Cl") = 71.6 ==> bar(M)_("Cl") = 35.8 " amu" $
  ۳) تعیین فراوانی ایزوتوپ‌های کلر:
  $ 35 + 2 times (F(37) / 100) = 35.8 ==> F(37) = 40% ==> F(35) = 60% $
  ۴) اختلاف درصد فراوانی:
  $ |F(35) - F(37)| = 60% - 40% = 20% $
])

#qbox(21, "عدد اتمی Y و الکترون‌های لایه با n+l=5", "صفحه ۳ • جامع ۲ - ۳", "۱", [
  *صورت سوال:* عنصر Y با جرم میانگین ۵۲/۳۲ دارای دو ایزوتوپ با اختلاف ذرات داخل هسته ۴ و ۶ است. اگر ایزوتوپ سبک‌تر ۶۸٪ فراوان‌تر باشد، عدد اتمی و الکترون‌های با $n+l=5$ کدام است؟
  
  *گام‌های حل تشریحی:*
  ۱) برای ایزوتوپ سبک‌تر $N_1 - Z = 4 ==> A_1 = 2Z + 4$ و برای سنگین‌تر $N_2 - Z = 6 ==> A_2 = 2Z + 6$.
  ۲) فراوانی‌ها:
  $ F_1 - F_2 = 68%, F_1 + F_2 = 100% ==> F_1 = 84%, F_2 = 16% $
  ۳) میانگین وزنی:
  $ bar(M) = A_1 + (A_2 - A_1) times 0.16 = (2Z + 4) + 2(0.16) = 52.32 ==> 2Z + 4.32 = 52.32 ==> Z = 24 $
  ۴) عنصر با $Z = 24$ کروم ($"Cr"$) با آرایش $["Ar"] 3d^5 4s^1$ است.
  الکترون‌های با $n+l=5$:
  - زیرلایه $3d$: $n = 3, l = 2 ==> n + l = 5$ (دارای ۵ الکترون).
  بنابراین عدد اتمی ۲۴ و شمار الکترون‌ها ۵ است (گزینه ۱).
])

#qbox(22, "محاسبه 4m-3n و نسبت زیرلایه‌ها در یون پایدار", "صفحه ۳ • جامع ۲ - ۴", "۲", [
  *صورت سوال:* در ایزوتوپ $""_(5n+1)^(8m+1)X$ تعداد نوترون‌ها ۱ واحد بیشتر از پروتون‌ها است. حاصل $4m-3n$ و نسبت الکترون‌های $l=0$ به $l=1$ در یون پایدار کدام است؟
  
  *گام‌های حل تشریحی:*
  ۱) تعداد پروتون‌ها $p = 5n + 1$ و نوترون‌ها $N = (8m + 1) - (5n + 1) = 8m - 5n$.
  $ N = p + 1 ==> 8m - 5n = 5n + 2 ==> 8m - 10n = 2 ==> 4m - 5n = 1 $
  کوچک‌ترین جواب طبیعی معنادار شیمیایی $n = 3$ و $m = 4$ است که در آن $Z = 5(3) + 1 = 16$ (گوگرد $"S"$) به دست می‌آید.
  ۲) مقدار $4m - 3n = 4(4) - 3(3) = 16 - 9 = 7$.
  ۳) یون پایدار گوگرد، آنیون سولفید ($"S"^(2-)$ با ۱۸ الکترون) است:
  - آرایش الکترونی: $1s^2 2s^2 2p^6 3s^2 3p^6$
  - الکترون‌های $l=0$ (اوربیتال‌های s): $2 + 2 + 2 = 6$
  - الکترون‌های $l=1$ (اوربیتال‌های p): $6 + 6 = 12$
  - نسبت: $6 / 12 = 0.5$
  بنابراین مقادیر به ترتیب: ۷ و ۰/۵.
])

#qbox(23, "واپاشی رادیوایزوتوپ رونتگنیم Rg", "صفحه ۳ • جامع ۲ - ۵", "۳", [
  *صورت سوال:* نیم‌عمر رادیوایزوتوپ رونتگنیم ۱۰ دقیقه است. پس از ۴۰ دقیقه از ۱۰ مول این ماده، چند اتم باقی می‌ماند؟ ($N_A = 6 times 10^(23)$)
  
  *گام‌های حل تشریحی:*
  ۱) تعداد نیم‌عمرهای سپری شده در ۴۰ دقیقه:
  $ n = (40) / (10) = 4 $
  ۲) کسر و مول باقی‌مانده:
  $ n_("باقی") = 10 times (1 / 2)^4 = (10) / (16) = 0.625 " mol" $
  ۳) شمار اتم‌های باقی‌مانده:
  $ N = 0.625 times (6 times 10^(23)) = 3.75 times 10^(23) " اتم" $
])

#qbox(24, "نوترون‌های ایزوتوپ سنگین‌تر با جرم میانگین ۱۲۶/۸", "صفحه ۳ • جامع ۲ - ۶", "۱", [
  *صورت سوال:* فراوانی ایزوتوپ سنگین‌تر ۶۰٪ بیشتر از سبک‌تر است. اگر در سبک‌تر $A = 2Z + 20$ و ۷۳ نوترون داشته باشیم و میانگین ۱۲۶/۸ باشد، نوترون‌های سنگین‌تر چند است؟
  
  *گام‌های حل تشریحی:*
  ۱) درصد فراوانی‌ها:
  $ F_2 - F_1 = 60%, F_1 + F_2 = 100% ==> F_2 = 80%, F_1 = 20% $
  ۲) در ایزوتوپ سبک‌تر:
  $ A_1 = Z + 73 $ و $ A_1 = 2Z + 20 ==> Z + 73 = 2Z + 20 ==> Z = 53 $ (عنصر ید $"I"$).
  پس $A_1 = 53 + 73 = 126$.
  ۳) جرم اتمی میانگین:
  $ 126.8 = 126 + (A_2 - 126) times 0.80 ==> 0.8 = 0.8(A_2 - 126) ==> A_2 - 126 = 1 ==> A_2 = 127 $
  ۴) شمار نوترون‌های ایزوتوپ سنگین‌تر:
  $ N_2 = A_2 - Z = 127 - 53 = 74 " نوترون" $
])

