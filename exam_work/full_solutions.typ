#qbox(25, "عدد اتمی Y با برابری الکترون‌های 37_X- و Y2+", "صفحه ۴ • جامع ۲ - ۵", "۳", [
  *صورت سوال:* شمار الکترون‌های $""^(37)X^-$ و $Y^(2+)$ برابر است. اگر مجموع پروتون‌های این دو یون برابر عدد جرمی $X$ باشد، عدد اتمی $Y$ کدام است؟
  
  *گام‌های حل تشریحی:*
  ۱) برابری الکترون‌ها:
  $ Z_X + 1 = Z_Y - 2 ==> Z_X = Z_Y - 3 $
  ۲) مجموع پروتون‌ها برابر عدد جرمی $X$ ($A_X = 37$):
  $ Z_X + Z_Y = 37 ==> (Z_Y - 3) + Z_Y = 37 ==> 2Z_Y = 40 ==> Z_Y = 20 $
  عدد اتمی $Y$ برابر ۲۰ (کلسیم) است.
])

#qbox(26, "الکترون‌های X و نسبت نوترون به عدد اتمی عنصر اصلی ماقبل", "صفحه ۴ • جامع ۲ - ۶", "۳", [
  *صورت سوال:* عدد جرمی $X^(2+)$ برابر ۲۲۰ و نوترون‌ها ۱/۷۵ برابر پروتون‌ها است. شمار الکترون‌های $X$ و نسبت نوترون‌ها به عدد اتمی آخرین عنصر اصلی ماقبل آن کدام است؟
  
  *گام‌های حل تشریحی:*
  ۱) در گونه با $A = 220$:
  $ p + N = 220 ==> p + 1.75 p = 220 ==> 2.75 p = 220 ==> p = 80 $
  شمار الکترون‌های اتم خنثی $X$: $e = 80$ (عنصر جیوه $"Hg"$).
  تعداد نوترون‌ها: $N = 220 - 80 = 140$.
  ۲) آخرین عنصر اصلی ماقبل جیوه در دوره ۶، باریم با $Z = 56$ است:
  $ "نسبت" = (140) / (56) = 2.5 $
  بنابراین مقادیر به ترتیب: ۸۰ و ۲/۵.
])

#qbox(27, "درصد فراوانی ایزوتوپ سبک‌تر", "صفحه ۴ • جامع ۲ - ۷", "۳", [
  *صورت سوال:* ایزوتوپ سبک‌تر به ترتیب ۵٪ و ۳۰٪ از دو ایزوتوپ دیگر فراوان‌تر است. درصد فراوانی آن کدام است؟
  
  *گام‌های حل تشریحی:*
  $ cases(F_2 = F_1 - 5, F_3 = F_1 - 30, F_1 + F_2 + F_3 = 100) ==> F_1 + (F_1 - 5) + (F_1 - 30) = 100 $
  $ 3F_1 - 35 = 100 ==> 3F_1 = 135 ==> F_1 = 45% $
])

#qbox(28, "نسبت باقی‌مانده به متلاشی‌شده پس از ۲۴ ساعت", "صفحه ۴ • جامع ۲ - ۸", "۱", [
  *صورت سوال:* نیم‌عمر ایزوتوپی ۸ ساعت است. پس از ۲۴ ساعت، جرم باقی‌مانده چند برابر متلاشی‌شده است؟
  
  *گام‌های حل تشریحی:*
  ۱) تعداد نیم‌عمرها: $n = 24 / 8 = 3$.
  ۲) کسر باقی‌مانده: $(1/2)^3 = 1/8$ و کسر متلاشی‌شده: $1 - 1/8 = 7/8$.
  ۳) نسبت:
  $ (m_("باقی")) / (m_("متلاشی")) = (1/8) / (7/8) = 1 / 7 $
])

#qbox(29, "تحلیل نمودار واپاشی رادیواکتیو A و B", "صفحه ۴ • جامع ۲ - ۹", "۲", [
  *صورت سوال:* با توجه به نمودار، جرم ماده A متلاشی‌شده در ۵۴ دقیقه چند برابر جرم B باقی‌مانده در ۹۶ دقیقه است؟
  
  *گام‌های حل تشریحی:*
  ۱) تحلیل نمودار در $t = 72 " min"$:
  - ماده A: از ۷۲ گرم به ۴/۵ گرم رسیده ($72 / 16 = 4.5 ==> 4$ نیم‌عمر). پس $t_(1/2)(A) = 72 / 4 = 18 " min"$.
  - ماده B: از ۴۸ گرم به ۶ گرم رسیده ($48 / 8 = 6 ==> 3$ نیم‌عمر). پس $t_(1/2)(B) = 72 / 3 = 24 " min"$.
  ۲) برای ماده A پس از ۵۴ دقیقه ($54 / 18 = 3$ نیم‌عمر):
  $ m_("باقی A") = 72 / 2^3 = 9 " g" ==> m_("متلاشی A") = 72 - 9 = 63 " g" $
  ۳) برای ماده B پس از ۹۶ دقیقه ($96 / 24 = 4$ نیم‌عمر):
  $ m_("باقی B") = 48 / 2^4 = 3 " g" $
  ۴) نسبت:
  $ "نسبت" = (63) / (3) = 21 $
])

#qbox(30, "برابری متلاشی‌شده A و باقی‌مانده B پس از ۴ ساعت", "صفحه ۴ • جامع ۲ - ۱۰", "۳", [
  *صورت سوال:* نیم‌عمر A و B برابر ۱۲۰ و ۸۰ دقیقه است. پس از ۴ ساعت اگر متلاشی‌شده A برابر باقی‌مانده B شود، جرم اولیه B چند برابر A است؟
  
  *گام‌های حل تشریحی:*
  ۱) زمان کل $t = 240 " min"$.
  - برای A: $240 / 120 = 2$ نیم‌عمر. جرم متلاشی‌شده: $m_(A 0)(1 - 1/4) = 3/4 m_(A 0)$.
  - برای B: $240 / 80 = 3$ نیم‌عمر. جرم باقی‌مانده: $m_(B 0)(1/8) = 1/8 m_(B 0)$.
  ۲) برابری مقادیر:
  $ 3 / 4 m_(A 0) = 1 / 8 m_(B 0) ==> m_(B 0) = 6 m_(A 0) ==> (m_(B 0)) / (m_(A 0)) = 6 $
])

#qbox(31, "نسبت جرم اتم به الکترون‌ها", "صفحه ۴ • جامع ۲ - ۱۱", "۳", [
  *صورت سوال:* اگر جرم نوکلئون‌ها ۲۰۰۰ برابر الکترون باشد، نسبت جرم اتم خنثی $""_Z^(2.5Z)X$ به الکترون‌هایش به کدام عدد نزدیک‌تر است؟
  
  *گام‌های حل تشریحی:*
  ۱) شمار نوکلئون‌ها $A = 2.5 Z$ و شمار الکترون‌ها در اتم خنثی برابر $Z$ است.
  ۲) جرم نوکلئون‌ها: $m_("هسته") approx 2.5 Z times (2000 m_e) = 5000 Z m_e$.
  ۳) نسبت جرم کل اتم به الکترون‌ها:
  $ "نسبت" approx (5000 Z m_e) / (Z m_e) = 5000 $
])

#qbox(32, "محاسبه توان کلسیم و نسبت جرمی CX به CX2", "صفحه ۴ • جامع ۲ - ۱۲", "۱", [
  *صورت سوال:* جرم اتم کربن-۱۲ معادل ۰/۳ جرم کلسیم است. اگر جرم کلسیم $6.64 times 10^(-n) " g"$ و جرم $X$ برابر $2.656 times 10^(-23) " g"$ باشد، $n$ و نسبت جرم یک مولکول $"CX"$ به $"CX"_2$ کدام است؟
  
  *گام‌های حل تشریحی:*
  ۱) جرم اتم کربن-۱۲ برابر $12 times 1.66 times 10^(-24) = 1.992 times 10^(-23) " g"$ است.
  $ m("Ca") = (1.992 times 10^(-23)) / (0.3) = 6.64 times 10^(-23) " g" ==> n = 23 $
  ۲) جرم اتمی $X$ برحسب amu:
  $ M_X = (2.656 times 10^(-23)) / (1.66 times 10^(-24)) = 16 " amu" $
  ۳) نسبت جرم مولکول $"CX"$ (یعنی $"CO"$) به مولکول $"CX"_2$ (یعنی $"CO"_2$):
  $ M("CX") = 12 + 16 = 28 " amu" , M("CX"_2) = 12 + 2(16) = 44 " amu" $
  $ "نسبت" = (28) / (44) = 7 / 11 approx 0.636 approx 0.63 $
  بنابراین مقادیر: ۲۳ و ۰/۶۳.
])

#qbox(33, "درصد جرمی پروتون‌ها در نمونه منیزیم", "صفحه ۴ • جامع ۲ - ۱۳", "۴", [
  *صورت سوال:* با توجه به شکل داده‌شده از ایزوتوپ‌های منیزیم، پروتون‌ها چند درصد جرم کل نمونه را تشکیل می‌دهند؟
  
  *گام‌های حل تشریحی:*
  ۱) تمامی اتم‌های منیزیم دارای عدد اتمی $Z = 12$ هستند.
  ۲) جرم اتمی میانگین نمونه طبیعی منیزیم حدود ۲۴/۳ amu است.
  ۳) درصد جرمی پروتون‌ها برابر نسبت جرم پروتون‌ها به جرم کل اتم‌ها است:
  $ %"پروتون‌ها" approx (12) / (24.3) times 100 = 49.38% approx 49% $
  (چون همه ایزوتوپ‌ها دارای نوترون بیشتر یا مساوی پروتون هستند، درصد کمتر از ۵۰٪ و نزدیک ۴۹٪ است).
])

#qbox(34, "جرم اتمی میانگین مس با ۸۰ اتم", "صفحه ۴ • جامع ۲ - ۱۴", "۴", [
  *صورت سوال:* در نمونه‌ای شامل ۸۰ اتم مس، ۳۰ اتم مس-۶۵ و مابقی مس-۶۳ هستند. جرم اتمی میانگین کدام است؟
  
  *گام‌های حل تشریحی:*
  ۱) شمار اتم‌های مس-۶۳: $80 - 30 = 50$ اتم.
  ۲) جرم اتمی میانگین:
