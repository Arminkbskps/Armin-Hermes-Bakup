  paper: "a4",
  margin: (x: 1.2cm, top: 1.4cm, bottom: 1.4cm),
  header: context {
    if here().page() > 1 [
      #grid(
        columns: (1fr, 1fr),
        align: (right, left),
        [ #text(size: 7.5pt, fill: rgb("#64748b"))[*پاسخ‌نامه تشریحی ۵۶ تست شیمی — ویراست ۳* • ساختار اتم، ایزوتوپ‌ها و استوکیومتری] ],
